# ===== Studio Route134 — sr134.com Under Construction =====
# 2026-09-13 しもんさん指示。サイト全体を非公開にし、どのURLで来ても
# トップページの案内画面だけを見せる。503ではなく通常表示（200）にする。
# 再開時は deploy/xserver-deploy.sh で通常のサイトを再配置すれば元に戻る。

# --- XServer の nginx キャッシュ。停止中は保存させない ---
SetEnvIf Request_URI ".*" Ngx_Cache_NoCacheMode=on

Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# www なしへ統一
RewriteCond %{HTTP_HOST} ^www\.sr134\.com$ [NC]
RewriteRule ^(.*)$ https://sr134.com/$1 [R=301,L]

# HTTPS へ統一
RewriteCond %{HTTPS} !on
RewriteRule ^(.*)$ https://sr134.com/$1 [R=301,L]

# 案内ページ本体とロゴ以外は、すべてトップへ送る（一時的なので302）
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !^/index\.html$
RewriteCond %{REQUEST_URI} !^/sr134_logo\.png$
RewriteRule ^ https://sr134.com/ [R=302,L]
</IfModule>

DirectoryIndex index.html

<IfModule mod_headers.c>
# 工事中の画面を検索結果に載せない
Header always set X-Robots-Tag "noindex, nofollow"
Header always set Cache-Control "no-store, no-cache, must-revalidate"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
